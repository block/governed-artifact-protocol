{
  "name": "governed-artifact-protocol",
  "private": true,
  "scripts": {
    "test:demo": "tsx --test \"demo/test/**/*.test.ts\"",
    "typecheck:demo": "tsc --noEmit -p demo/tsconfig.json",
    "check:specification": "node --test \"specification/test/*.test.mjs\" && node specification/check-specification.mjs",
    "examples:generate": "tsx demo/examples/generate.ts",
    "examples:check": "tsx demo/examples/generate.ts --check",
    "docs:sync": "pnpm --filter governed-artifact-protocol-docs sync",
    "docs:dev": "pnpm --filter governed-artifact-protocol-docs start",
    "docs:build": "pnpm --filter governed-artifact-protocol-docs build",
    "docs:serve": "pnpm --filter governed-artifact-protocol-docs serve",
    "docs:test": "pnpm --filter governed-artifact-protocol-docs test"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.33.0"
}
